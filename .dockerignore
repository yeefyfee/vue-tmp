# ==============================================================================
# Docker 构建上下文排除规则（仓库根上下文，CROSS-20 monorepo 适配）
# ==============================================================================

# ---- 依赖与构建产物（镜像内会重新安装 / 构建）----
**/node_modules
**/dist
**/dist_stale_bak_*
**/dist_partial_bak_*
**/logs
**/coverage
.nyc_output

# ---- 版本控制 / 编辑器 ----
.git
.gitignore
.history
.vscode
.idea

# ---- 环境变量：镜像内只保留 niulai-nest/.env（非敏感） ----
# .env.prod / .env.dev 含数据库密码与 JWT 密钥，不进镜像，由 compose env_file 注入
**/.env.prod
**/.env.dev
**/.env.*.local

# ---- WorkBuddy 工作区数据 ----
.workbuddy

# ---- Docker 相关文件自身 ----
**/Dockerfile
**/.dockerignore
**/docker-compose*.yml

# ---- 杂项 ----
*.log
.DS_Store
