# ==============================================================================
# Docker 构建上下文排除规则
# 目的：缩小构建上下文、避免把本机数据与密钥送进 daemon
# ==============================================================================

# ---- 依赖与构建产物（镜像内会重新安装 / 构建）----
node_modules
**/node_modules
dist
logs
coverage
.nyc_output

# ---- 版本控制 / 编辑器 ----
.git
.gitignore
.history
.vscode
.idea

# ---- 环境变量：镜像内只保留 .env ----
# .env.prod 含数据库密码与 JWT 密钥，不进镜像，改由 compose 的 env_file 注入
.env.prod
.env.dev
.env.niulai
.env.*.local

# ---- Docker 本地数据目录（切勿打进上下文）----
docker/**/data
docker/**/config

# ---- Docker 相关文件自身 ----
Dockerfile
.dockerignore
docker-compose*.yml

# ---- 杂项 ----
*.log
.DS_Store
