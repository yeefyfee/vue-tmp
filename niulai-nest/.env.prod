# =========================
# 应用基础配置
# =========================

# 运行环境：dev / prod / test
NODE_ENV=prod

# Nest 应用监听端口（统一后端端口：8000）
APP_PORT=8000

# 会话类型：jwt | redis-token
SESSION_TYPE=jwt


# =========================
# PostgreSQL 16 数据库配置（Prisma）
# =========================
# 生产连接串由 docker-compose / 编排层注入即可（环境变量优先于本文件）

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=Pg@123456
PG_DB=peluvida_admin

# Prisma CLI（migrate / studio）读取的连接串，必须与上面的 PG_* 指向同一个库
DATABASE_URL=postgresql://admin:Pg%40123456@127.0.0.1:5432/peluvida_admin

# Prisma 查询日志输出
DATABASE_LOGGING=false


# =========================
# Redis 配置
# =========================
# 用于缓存、会话、验证码等

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=7
# 无密码可以留空
REDIS_PASSWORD=


# =========================
# JWT 认证配置
# =========================
# 对应 src/config/jwt.config.ts 中的 JWT_SECRET_KEY / JWT_EXPIRES_IN / JWT_ISSUER

# =========================
# AI 配置（OpenAI-compatible）
# =========================

# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# AI_API_KEY=sk-c2941d05bf2f411ca80424fcd1exxxxx
# AI_MODEL=qwen-plus
# AI_TIMEOUT_MS=20000

# JWT密钥(HS256算法至少32字符)
JWT_SECRET_KEY=SecretKey012345678901234567890123456789012345678901234567890123456789

# 访问 Token 过期时间（单位：秒，例如 7200 表示 2 小时）
JWT_EXPIRES_IN=7200

# Token 签发方标识，用于区分不同系统
JWT_ISSUER=niulai-nest


# =========================
# OSS / 文件存储（MinIO / 阿里云 / 本地）
# =========================

# OSS 类型：aliyun | minio | local
OSS_TYPE=minio

# MinIO 对象存储服务
OSS_MINIO_ENDPOINT=http://127.0.0.1:9000
OSS_MINIO_ACCESS_KEY=minioadmin
OSS_MINIO_SECRET_KEY=minioadmin
OSS_MINIO_BUCKET=default
# 可选：自定义域名，配置后文件 URL 会使用该域名
OSS_MINIO_CUSTOM_DOMAIN=

# 阿里云 OSS 对象存储服务
# OSS_ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ALIYUN_ACCESS_KEY_ID=your-access-key-id
# OSS_ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_ALIYUN_BUCKET=default

# 本地存储路径（仅在 OSS_TYPE=local 时生效）
# OSS_LOCAL_STORAGE_PATH=D:/data/oss/

# ================================
# 微信小程序配置
# ================================
# WX_MINIAPP_APP_ID=Your_AppId
# WX_MINIAPP_APP_SECRET=Your_AppSecret
