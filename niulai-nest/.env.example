# =====================================================================
# PeluVida OS 环境变量样例（CROSS-06 环境配置规范）
#
# 使用方式：
#   1. 复制为 .env.dev（开发）/ .env.prod（生产），按环境填值；
#   2. .env 中的变量优先级高于 .env.<NODE_ENV>（envFilePath 数组顺序）；
#   3. 启动期由 src/config/env.validation.ts 校验：缺失/非法的变量会
#      在应用启动时一次性报错列出，fail-fast；
#   4. 本文件只含占位符，严禁提交任何真实密码 / 密钥。
# =====================================================================

# =========================
# 应用基础配置
# =========================

# 运行环境：dev | prod | test（必需）
NODE_ENV=dev

# Nest 应用监听端口（必需，正整数）
APP_PORT=8000

# 会话类型：jwt | redis-token（可选，默认 jwt）
SESSION_TYPE=jwt


# =========================
# PostgreSQL 16 数据库配置（Prisma）
# =========================
# PG_* 五项必需；DATABASE_URL 供 Prisma CLI（migrate/studio）使用，
# 应用侧缺失时会由 PG_* 自动拼装，但两者必须指向同一个库。
# 密码中的特殊字符需 URL 转义（如 @ → %40）。

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=your_db_user
PG_PASSWORD=your_db_password
PG_DB=peluvida_dev

# Prisma CLI 连接串（必需）
DATABASE_URL=postgresql://your_db_user:your_db_password@127.0.0.1:5432/peluvida_dev

# Prisma 查询日志输出：true | false（dev 建议 true，prod 建议 false）
DATABASE_LOGGING=true


# =========================
# Redis 配置
# =========================
# 用于缓存、会话（SESSION_TYPE=redis-token 时为硬依赖）、验证码等
# REDIS_HOST / REDIS_PORT 必需；无密码可留空
# ⚠️ 用 docker/docker-compose.yml 启动依赖时，Redis 设了密码，此处必须填 123456

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=7
REDIS_PASSWORD=


# =========================
# JWT 认证配置
# =========================
# 三项必需；HS256 算法要求 JWT_SECRET_KEY 至少 32 字符

JWT_SECRET_KEY=change_me_to_a_random_string_at_least_32_chars_long
# 访问 Token 过期时间（单位：秒）
JWT_EXPIRES_IN=7200
# Token 签发方标识
JWT_ISSUER=niulai-nest


# =========================
# OSS / 文件存储（MinIO / 阿里云 / 本地）
# =========================
# OSS_TYPE：aliyun | minio | local（可选，默认 aliyun）
# 选定类型后，对应分组的连接参数变为必需（启动期校验）

OSS_TYPE=minio

# MinIO（OSS_TYPE=minio 时必需）
OSS_MINIO_ENDPOINT=http://localhost:9000
OSS_MINIO_ACCESS_KEY=your_minio_access_key
OSS_MINIO_SECRET_KEY=your_minio_secret_key
OSS_MINIO_BUCKET=default
# 可选：自定义域名，配置后文件 URL 会使用该域名
OSS_MINIO_CUSTOM_DOMAIN=

# 阿里云 OSS（OSS_TYPE=aliyun 时必需）
OSS_ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ALIYUN_ACCESS_KEY_ID=your-access-key-id
OSS_ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ALIYUN_BUCKET=default

# 本地存储路径（OSS_TYPE=local 时必需）
OSS_LOCAL_STORAGE_PATH=D:/data/oss/


# =========================
# 微信小程序配置（预留）
# =========================
# 说明：小程序业务模块已随 PeluVida 剥离，以下为预留键，
# 当前代码零引用，可按需填写，校验器不强制。

WX_MINIAPP_APP_ID=
WX_MINIAPP_APP_SECRET=


# =========================
# AI 配置（预留，OpenAI-compatible）
# =========================
# 说明：AI 能力为预留键，当前代码零引用，校验器仅在提供值时
# 检查 AI_TIMEOUT_MS 为正整数，其余不强制。

AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_API_KEY=your_ai_api_key
AI_MODEL=qwen-plus
AI_TIMEOUT_MS=20000
